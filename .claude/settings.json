{
  "permissions": {
    "allow": [
      "Bash(echo \"exit: $?\")",
      "Bash(git rm:*)"
    ],
    "deny": [
      "Read(./config/device-qc-credentials.js)",
      "Read(./fastlane/.env)",
      "Read(./fastlane/.env.secret)",
      "Read(./.mcp.json)",
      "Read(./.env.*)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.p12)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/ai/guard/engine.js\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.js\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
