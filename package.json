{
  "name": "ai-agent-workflow-runtime",
  "version": "1.5.3",
  "description": "Deterministic agentic engineering runtime with Hybrid RAG, guarded stage progression, evidence, evals, and Claude/Codex execution.",
  "license": "MIT",
  "author": "Mohamed Elsdody",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedma872/ai-agent-workflow-kit"
  },
  "scripts": {
    "guard:check": "node ai/guard/engine.js --check",
    "guard:explain": "node ai/guard/engine.js --explain",
    "guard:selftest": "node ai/guard/engine.js --selftest",
    "workflow:check": "node ai/workflow/version.js check && node ai/workflow/router.js check && node ai/workflow/conditions.js check && node ai/workflow/execution-policy.js check ai/workflows/feature.yaml",
    "workflow:show": "node ai/workflow/router.js show feature",
    "workflow:version": "node ai/workflow/version.js version",
    "workflow:version:json": "node ai/workflow/version.js --json",
    "workflow:version:check": "node ai/workflow/version.js check",
    "workflow:release:check": "node ai/workflow/release.js check",
    "workflow:release": "node ai/workflow/release.js",
    "workflow:doctor": "node ai/workflow/doctor.js",
    "workflow:doctor:json": "node ai/workflow/doctor.js --json",
    "workflow:start": "node ai/workflow/engine.js start",
    "workflow:next": "node ai/workflow/engine.js next",
    "workflow:run-next": "node ai/workflow/engine.js run-next",
    "workflow:resume": "node ai/workflow/engine.js resume",
    "workflow:run": "node ai/workflow/engine.js run",
    "workflow:worktree": "node ai/workflow/engine.js worktree",
    "workflow:cleanup": "node ai/workflow/engine.js cleanup",
    "workflow:artifacts:check": "node ai/workflow/artifacts.js check-schemas",
    "workflow:rag": "node ai/rag/hybrid-rag.js",
    "workflow:rag:selftest": "node ai/rag/hybrid-rag.js --selftest",
    "agentic": "node ai/cli/agentic.js",
    "agentic:selftest": "node ai/cli/agentic.js selftest && node ai/cli/external-project-selftest.js",
    "workflow:progress": "node ai/workflow/progress.js",
    "workflow:progress:watch": "node ai/workflow/progress.js --watch",
    "workflow:progress:json": "node ai/workflow/progress.js --json",
    "workflow:progress:github": "node ai/workflow/github-progress.js",
    "workflow:progress:github:watch": "node ai/workflow/github-progress.js --watch",
    "workflow:verify:github": "node ai/workflow/github-verification.js publish",
    "workflow:verify:github:build": "node ai/workflow/github-verification.js build",
    "workflow:enforcement:check": "node ai/workflow/github-enforcement.js check",
    "workflow:enforcement:apply": "node ai/workflow/github-enforcement.js apply",
    "workflow:enforcement:explain": "node ai/workflow/github-enforcement.js explain",
    "workflow:mobile-evidence": "node ai/tasks/feature/mobile-evidence.js run",
    "workflow:mobile-evidence:dry-run": "node ai/tasks/feature/mobile-evidence.js run --dry-run",
    "mcp:codex": "node ai/mcp/codex-delegate.mjs",
    "eval": "node ai/evals/run.js",
    "prepare": "husky",
    "exam:check": "node ai/evals/runtime-hardening-check.js && node ai/evals/auto.js check",
    "exam:live": "node ai/evals/auto.js live",
    "exam:nightly": "node ai/evals/runtime-hardening-check.js && node ai/evals/auto.js nightly",
    "exam:schedule": "node ai/evals/auto.js schedule",
    "workflow:subagents:check": "node ai/workflow/subagent-contracts.js check",
    "workflow:subagents:show": "node ai/workflow/subagent-contracts.js show",
    "workflow:subagents:select:selftest": "node ai/workflow/subagent-selector.js --selftest",
    "workflow:subagents:synthesis:selftest": "node ai/workflow/finding-synthesis.js --selftest",
    "workflow:conflict:resolve": "node ai/workflow/conflicts.js resolve",
    "exam:subagents:check": "node ai/evals/subagents/check.js",
    "exam:subagents:selftest": "node ai/evals/subagents/check.js --selftest && node ai/evals/subagent-metrics.js --selftest && node ai/workflow/subagent-telemetry.js --selftest",
    "workflow:subagents:report": "node ai/workflow/subagent-report.js",
    "exam:subagents:live": "node ai/evals/auto.js live --tasks subagent --agents claude",
    "workflow:refactor:mode:selftest": "node ai/workflow/refactor-mode.js --selftest",
    "workflow:refactor:coverage": "node ai/workflow/refactor-coverage.js",
    "workflow:refactor:checkpoint": "node ai/workflow/refactor-checkpoints.js record",
    "workflow:refactor:gates:selftest": "node ai/workflow/refactor-coverage.js --selftest && node ai/workflow/refactor-checkpoints.js --selftest && node ai/workflow/refactor-verification-matrix.js --selftest",
    "workflow:refactor:report": "node ai/workflow/refactor-report.js",
    "workflow:refactor:equivalence:selftest": "node ai/workflow/refactor-contract-diff.js --selftest && node ai/workflow/refactor-telemetry.js --selftest",
    "refactor": "node ai/workflow/refactor-cli.js run",
    "refactor:approve": "node ai/workflow/refactor-cli.js approve",
    "refactor:status": "node ai/workflow/refactor-cli.js status",
    "refactor:report": "node ai/workflow/refactor-report.js",
    "refactor:app": "node ai/workflow/refactor-cli.js app",
    "refactor:architecture": "node ai/workflow/refactor-cli.js architecture"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentic": "ai/cli/agentic.js"
  }
}
