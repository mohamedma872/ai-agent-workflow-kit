{
  "name": "ai-agent-workflow-kit",
  "version": "0.3.1",
  "description": "Provider-independent agentic workflows with shared guardrails, MCP delegation, and end-state evals for Claude Code, Codex, and future coding agents.",
  "license": "MIT",
  "author": "Mohamed Elsdody",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedma872/ai-agent-workflow-kit"
  },
  "scripts": {
    "guard:check": "node ai/guard/engine.js --check",
    "guard:explain": "node ai/guard/engine.js --explain",
    "guard:selftest": "node ai/guard/engine.js --selftest",
    "workflow:check": "node ai/workflow/router.js check",
    "workflow:show": "node ai/workflow/router.js show feature",
    "mcp:codex": "node ai/mcp/codex-delegate.mjs",
    "eval": "node ai/evals/run.js",
    "prepare": "husky",
    "exam:check": "node ai/evals/auto.js check",
    "exam:live": "node ai/evals/auto.js live",
    "exam:nightly": "node ai/evals/auto.js nightly",
    "exam:schedule": "node ai/evals/auto.js schedule"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
