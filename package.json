{
  "name": "ai-guardrails-evals",
  "version": "0.3.0",
  "description": "Provider-independent agentic workflows with shared guardrails and end-state evals for Claude Code, Codex, and future coding agents.",
  "license": "MIT",
  "author": "Mohamed Elsdody",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedma872/ai-guardrails-evals"
  },
  "scripts": {
    "guard:check": "node ai/guard/engine.js --check",
    "guard:explain": "node ai/guard/engine.js --explain",
    "guard:selftest": "node ai/guard/engine.js --selftest",
    "workflow:check": "node ai/workflow/router.js check",
    "workflow:show": "node ai/workflow/router.js show feature",
    "eval": "node ai/evals/run.js",
    "prepare": "husky"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
