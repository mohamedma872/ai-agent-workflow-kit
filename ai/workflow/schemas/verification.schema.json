{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workflow-runtime.local/schemas/verification-v1.json",
  "title": "Final Verification Artifact",
  "type": "object",
  "required": ["schemaVersion", "runId", "status", "acceptanceCriteria", "definitionOfDone"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail", "blocked"] },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pass", "fail", "blocked", "not-applicable"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "definitionOfDone": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "status"],
        "properties": {
          "item": { "type": "string" },
          "status": { "enum": ["pass", "fail", "blocked", "not-applicable"] }
        }
      }
    },
    "mobileEvidence": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
