{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workflow-runtime.local/schemas/subagent-findings-v1.json",
  "title": "Subagent Findings Artifact",
  "type": "object",
  "required": ["schemaVersion", "runId", "agent", "status", "findings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "blocked"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "uncertainty", "confidence", "evidence", "recommendation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 3},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "uncertainty": {"enum": ["confirmed", "likely", "possible", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "detail"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "line": {"type": ["integer", "null"]},
                "detail": {"type": "string", "minLength": 3}
              }
            }
          },
          "recommendation": {"type": "string", "minLength": 3},
          "tags": {"type": "array", "items": {"type": "string"}},
          "conflictsWith": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
