{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workflow-runtime.local/schemas/subagent-conflicts-v1.json",
  "title": "Subagent Conflict Artifact",
  "type": "object",
  "required": ["schemaVersion", "conflicts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "findings", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^CONFLICT-[0-9]{3,}$"},
          "topic": {"type": "string", "minLength": 1},
          "findings": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "status": {"enum": ["unresolved", "resolved"]},
          "resolution": {
            "type": ["object", "null"],
            "properties": {
              "decision": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "resolvedAt": {"type": "string", "minLength": 1}
            },
            "required": ["decision", "rationale", "owner", "resolvedAt"]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
