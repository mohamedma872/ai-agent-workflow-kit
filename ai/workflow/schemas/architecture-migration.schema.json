{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workflow-runtime.local/schemas/architecture-migration-v1.json",
  "title": "Architecture Migration Waves",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "domains",
    "waves",
    "integrationCheckpoints",
    "rollbackStrategy",
    "completionCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "risk",
          "dependsOn"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "behaviorCoverage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domains",
          "goal",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "goal": {
            "type": "string"
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rollbackPoint": {
            "type": "string"
          }
        }
      }
    },
    "integrationCheckpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollbackStrategy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completionCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
