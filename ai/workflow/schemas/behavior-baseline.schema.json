{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ai-agent-workflow-runtime.local/schemas/behavior-baseline-v1.json",
  "title":"Behavior Baseline",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","runId","observableBehaviors","publicApis","stateTransitions","sideEffects","apiCalls","storageContracts","navigationContracts","analyticsEvents","errorBehavior","concurrencyBehavior","lifecycleBehavior","knownUnverifiedAreas"],
  "properties":{
    "schemaVersion":{"const":1},"runId":{"type":"string","minLength":1},
    "observableBehaviors":{"type":"array","items":{"$ref":"#/$defs/behavior"}},
    "publicApis":{"type":"array","items":{"type":"string"}},
    "stateTransitions":{"type":"array","items":{"type":"string"}},
    "sideEffects":{"type":"array","items":{"type":"string"}},
    "apiCalls":{"type":"array","items":{"type":"string"}},
    "storageContracts":{"type":"array","items":{"type":"string"}},
    "navigationContracts":{"type":"array","items":{"type":"string"}},
    "analyticsEvents":{"type":"array","items":{"type":"string"}},
    "errorBehavior":{"type":"array","items":{"type":"string"}},
    "concurrencyBehavior":{"type":"array","items":{"type":"string"}},
    "lifecycleBehavior":{"type":"array","items":{"type":"string"}},
    "knownUnverifiedAreas":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{"behavior":{"type":"object","additionalProperties":false,"required":["id","description","criticality","coverage"],"properties":{
    "id":{"type":"string","minLength":1},"description":{"type":"string","minLength":3},"criticality":{"enum":["critical","high","medium","low"]},
    "coverage":{"type":"object","additionalProperties":false,"required":["status","evidence"],"properties":{"status":{"enum":["covered","uncovered","waived"]},"evidence":{"type":"array","items":{"type":"string"}},"waiverReason":{"type":["string","null"]},"waiverOwner":{"type":["string","null"]}}}
  }}}
}
