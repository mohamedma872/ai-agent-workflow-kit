{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workflow-runtime.local/schemas/build-test-v1.json",
  "title": "Build and Test Artifact",
  "type": "object",
  "required": ["schemaVersion", "runId", "status", "commands"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "blocked"]},
    "commands": {"type": "array", "items": {"type": "object", "required": ["command", "status"], "properties": {"command": {"type": "string"}, "status": {"enum": ["pass", "fail", "blocked", "skipped"]}, "exitCode": {"type": ["integer", "null"]}, "durationMs": {"type": ["number", "null"]}}}},
    "tests": {"type": "object", "properties": {"passed": {"type": "integer"}, "failed": {"type": "integer"}, "skipped": {"type": "integer"}}}
  },
  "additionalProperties": true
}
