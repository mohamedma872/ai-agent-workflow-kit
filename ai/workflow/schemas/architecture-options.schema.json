{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workflow-runtime.local/schemas/architecture-options-v1.json",
  "title": "Architecture Options and Trade-offs",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "runId",
    "options",
    "recommendation",
    "decisionNotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "style",
          "summary",
          "benefits",
          "tradeoffs",
          "risks",
          "migration",
          "criterionScores",
          "c4Preview"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "style": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "benefits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "migration": {
            "type": "object",
            "required": [
              "effort",
              "complexity",
              "reversibility",
              "rollback"
            ],
            "properties": {
              "effort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "very-high"
                ]
              },
              "complexity": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "very-high"
                ]
              },
              "reversibility": {
                "enum": [
                  "easy",
                  "moderate",
                  "hard"
                ]
              },
              "rollback": {
                "type": "string"
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "teamImpact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliveryImpact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operationsImpact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "securityImpact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "performanceImpact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testabilityImpact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criterionScores": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "criterionId",
                "score",
                "evidence"
              ],
              "properties": {
                "criterionId": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "c4Preview": {
            "type": "object",
            "required": [
              "systemContext",
              "containers",
              "components"
            ],
            "properties": {
              "systemContext": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "containers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dynamicFlows": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deployment": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "optionId",
        "rationale",
        "caveats"
      ],
      "properties": {
        "optionId": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decisionNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
