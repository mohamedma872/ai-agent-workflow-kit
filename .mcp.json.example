{
  "mcpServers": {
    "codex-delegate": {
      "command": "node",
      "args": ["ai/mcp/codex-delegate.mjs"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    }
  }
}
