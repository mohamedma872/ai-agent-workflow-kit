{
  "mcpServers": {
    "codex-delegate": {
      "command": "node",
      "args": ["ai/mcp/codex-delegate.mjs"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    }
  },
  "_optionalRoleScopedServers": {
    "note": "Appium is the recommended native mobile QA MCP but requires a Node 22+ MCP environment. Configure it in your user/local MCP settings when Android/iOS device validation is needed; see ai/mcp/README.md. Do not load it globally for non-mobile roles."
  }
}
